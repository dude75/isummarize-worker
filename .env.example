# Скопируйте в `.env` и заполните токены. Файл `.env` в git не коммитить.

# Bearer для API (все маршруты кроме /health и /ready). Пустой = никто не пройдёт.
API_TOKEN=

# OpenAI-совместимый endpoint. Пользователь заполняет сам.
BASE_URL=
API_KEY=
MODEL=

HOST=127.0.0.1
PORT=8000

DATA_DIR=./data
SQLITE_PATH=./data/tasks.db
LOG_DIR=./data/logs
PERFORMANCE_LOG=./data/logs/performance_log.csv
# Прикладной лог-файл + app-logger. false / 0 / no — выкл.
LOG_ENABLED=true
# Ротация app.log по размеру (байты) и число копий app.log.1 … N.
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
# CSV метрик + JSON metric_event в stdout. false / 0 / no — выкл.
PERFORMANCE_LOG_ENABLED=true
# Prometheus /metrics. false / 0 / no — прикладные метрики выкл., endpoint остаётся.
METRICS_ENABLED=true

# Слоты задач в одном процессе uvicorn (не --workers).
# Слот = одна одновременно выполняющаяся задача саммаризации.
# WORKERS_MAX — синоним для GET /health workers.max (hub Capacity).
WORKERS=1
# Максимум задач в queued. Сверх лимита — 503 queue_full.
WORKER_QUEUE_SIZE=4
# Максимум тела POST /summarize в байтах (Content-Length и фактический JSON). По умолчанию 10 MiB.
MAX_PAYLOAD_BYTES=10485760
# Секунд после success/error до удаления строки из SQLite. 0 — не удалять по TTL.
TASK_TTL_SEC=3600
# Сколько раз вернуть running в queued после смерти процесса.
# По умолчанию 1 — одна повторная попытка, дальше error process_killed. 0 — сразу ошибка.
TASK_MAX_RESTARTS=1
# Лимит wall-clock на одну running-задачу (секунды). 0 — без лимита (не рекомендуется).
TASK_TIMEOUT_SEC=3600

# Таймаут одного HTTP-вызова к LLM. 0 — без лимита (не рекомендуется).
LLM_TIMEOUT_SEC=120
# Кэш GET {BASE_URL}/models для /health и /ready. 0 — без кэша.
LLM_PROBE_TTL_SEC=15
# Повторы при сети / 429 / 5xx (сверх первой попытки).
LLM_MAX_RETRIES=2
# Пустое = не отправлять поле max_tokens.
MAX_TOKENS=
TEMPERATURE=0.2
